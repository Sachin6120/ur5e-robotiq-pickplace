<?xml version="1.0"?>
<!--
  ur5e_robotiq.urdf.xacro — M-1 merged platform.

  UR5e (ur_description) + Robotiq 2F-85 (robotiq_description), wired for
  Gazebo Harmonic through gz_ros2_control.

  DESIGN NOTES, so the choices here are auditable later:

  1. The ARM'S KINEMATICS come from ur_description's `ur_robot` macro. They are
     not hand-written — that is a hard requirement of the project spec.

  2. The ARM'S ros2_control BLOCK is written out below rather than pulled from
     ur_simulation_gz. Reason: control wiring is not kinematic description, it is
     six joints with position command/state interfaces, and writing it here keeps
     the merged model self-contained and readable instead of depending on the
     internals of a package whose xacro API we would then also have to track.
     If you would rather reuse ur_simulation_gz's wiring, that swap is localised
     to the <ros2_control name="UR5eSystem"> block and nothing else changes.

  3. The GRIPPER'S ros2_control block is NOT written here. The
     `robotiq_gripper` macro emits it itself when include_ros2_control is true
     (its default), and under sim_ignition:=true it emits
     <plugin>ign_ros2_control/IgnitionSystem</plugin>, which resolves via the
     backward-compat alias registered in gz_ros2_control's plugin XML.
     Do not set use_fake_hardware here — mock hardware echoes commands back as
     state with no physics and would grasp nothing while looking healthy.

  4. MIMIC JOINTS. Of the 2F-85's five non-actuated joints, three still mimic
     robotiq_85_left_knuckle_joint (right_knuckle, left/right_inner_knuckle);
     the other two (left/right_finger_tip) were changed to type="fixed" by
     the TENTH OVERRIDE (robotiq_2f_85_macro.urdf.xacro) and no longer mimic
     anything. Under sim_ignition the three mimic joints carry no command or
     state interfaces at all; enforcement is delegated to gz-sim's constraint
     solver by the package author's design. Nothing in this file proves that
     solver works. M0-C is the only evidence. Do not treat a clean spawn as a
     working linkage.

  USAGE
    xacro ur5e_robotiq.urdf.xacro > /tmp/merged.urdf
    xacro ur5e_robotiq.urdf.xacro sim_ignition:=true gripper_rotation:=0.0

  NAME IS HARDCODED ON THE ROOT TAG BELOW, NOT $(arg name).
    $(arg name) on the root <robot> tag resolves before its own in-document
    <xacro:arg name="name"> declaration is registered — xacro processes
    substitutions top-down, and the tag's own attributes are the first thing
    evaluated. This isn't a defect specific to this file: ur_simulation_gz's
    own ur_gz.urdf.xacro has the identical pattern and fails the identical way
    if invoked without name:= on the command line.
    It has bitten four different callers in this project: the merge validator,
    the sim launch file, and twice in MoveIt Setup Assistant — the "create new
    config" flow threads a typed name:= through correctly, but the "load
    existing config" flow does not, and silently produces a garbage/unparsed
    URDF ("URDF/COLLADA file is not a valid robot model") instead of surfacing
    the real xacro error.
    Since `name` is never actually varied anywhere in this project — every
    caller always passes ur5e_robotiq — hardcoding it here removes the
    ordering dependency permanently instead of continually patching every new
    caller that hits it. The <xacro:arg name="name"> declaration below is kept
    so existing callers that still pass name:=ur5e_robotiq explicitly
    (harmlessly unused now) don't need to change.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ur5e_robotiq">

  <!-- ===================================================================== -->
  <!-- Arguments                                                             -->
  <!-- ===================================================================== -->
  <xacro:arg name="name"      default="ur5e_robotiq"/>
  <xacro:arg name="ur_type"   default="ur5e"/>
  <xacro:arg name="tf_prefix" default=""/>

  <!-- MUST be true for Gazebo. false silently gives you the USB driver path. -->
  <xacro:arg name="sim_ignition" default="true"/>

  <!-- Rotation of the gripper about the flange approach axis, radians.
       This is the physical mounting clock position of the gripper, and it is
       what grasp.gripper_roll in config/scene.yaml is measured relative to.
       Changing it here changes where the fingers point in the world. -->
  <xacro:arg name="gripper_rotation" default="0.0"/>

  <!-- Fixed overhead RGB-D camera (eye-to-hand). OFF by default: with this
       false the expanded URDF is byte-identical to the pre-camera baseline,
       so the validated classical pipeline is unaffected unless a caller opts
       in with enable_camera:=true. See the CAMERA block near the end of this
       file for the mount derivation. -->
  <xacro:arg name="enable_camera" default="false"/>
  <xacro:arg name="camera_width" default="960"/>
  <xacro:arg name="camera_height" default="720"/>

  <!-- Where the arm base is bolted, in the world frame. Keep consistent with
       the table pose in config/scene.yaml. -->
  <xacro:arg name="base_xyz" default="0 0 0"/>
  <xacro:arg name="base_rpy" default="0 0 0"/>

  <!-- Fixed-fingertip angle, radians. See robotiq_2f_85_macro.urdf.xacro's
       TENTH OVERRIDE for why both fingertip joints became fixed instead of
       continuously mimic-tracking, and config/scene_xacro_args.py's
       xacro_gripper_args() for the derivation
       (theta_for_width(object.size[grasp_width_axis])). OBJECT-SIZE-SPECIFIC:
       changing config/scene.yaml's object.size without re-deriving this value
       leaves the pad tilted at the wrong angle at grasp, silently. The
       default below matches the object this project has used all session
       (45mm cube); do not rely on it for a different object. -->
  <xacro:arg name="fingertip_grasp_theta" default="0.4029"/>
  <!-- Evaluation-only. Adds contact observers, never collision/physics data. -->
  <xacro:arg name="enable_diagnostic_contacts" default="false"/>

  <!-- OPT-IN gripper model selector, added for the DART-compatible
       parallel-jaw redesign (docs/GRIPPER_REDESIGN_DESIGN.md). Default
       "robotiq_linkage" reproduces the exact existing expansion: the
       <xacro:if>/<xacro:unless> pair below is the ONLY change this selector
       makes to that path, and merely including parallel_jaw_gripper.urdf.xacro
       is inert unless gripper_model:=parallel_jaw actually invokes its macro.
       "parallel_jaw" is the validated DART-compatible baseline: wired into
       controllers.yaml (parallel_jaw_gripper_controller), MoveIt
       (moveit_controllers_parallel_jaw.yaml), and confirmed by the 5/5
       Scene-A repeatability campaign and the G1-G5 Generalization Stage-1
       PASS (see HANDOFF.md). -->
  <xacro:arg name="gripper_model" default="robotiq_linkage"/>
  <xacro:property name="gripper_model" value="$(arg gripper_model)"/>

  <!-- Simulation-only arm spawn state.  The sim launch derives these six
       arguments from scene.yaml milestones.m1.goal_positions.  Defaults keep
       direct xacro users on the historical home pose. -->
  <xacro:arg name="initial_shoulder_pan" default="0.0"/>
  <xacro:arg name="initial_shoulder_lift" default="-1.5708"/>
  <xacro:arg name="initial_elbow" default="1.5708"/>
  <xacro:arg name="initial_wrist_1" default="-1.5708"/>
  <xacro:arg name="initial_wrist_2" default="-1.5708"/>
  <xacro:arg name="initial_wrist_3" default="0.0"/>

  <!-- Controller parameter file handed to the gz_ros2_control system plugin. -->
  <xacro:arg name="controllers_file"
             default="$(find ur5e_robotiq_description)/config/controllers.yaml"/>

  <!-- UR parameter files. Paths follow ur_description's config/<ur_type>/ layout.
       If any of these fail to resolve, scripts/03_validate_merge.sh reports the
       exact missing path rather than a generic xacro error. -->
  <xacro:arg name="joint_limits_parameters_file"
             default="$(find ur_description)/config/$(arg ur_type)/joint_limits.yaml"/>
  <xacro:arg name="kinematics_parameters_file"
             default="$(find ur_description)/config/$(arg ur_type)/default_kinematics.yaml"/>
  <xacro:arg name="physical_parameters_file"
             default="$(find ur_description)/config/$(arg ur_type)/physical_parameters.yaml"/>
  <xacro:arg name="visual_parameters_file"
             default="$(find ur_description)/config/$(arg ur_type)/visual_parameters.yaml"/>

  <xacro:property name="tf_prefix" value="$(arg tf_prefix)"/>

  <!-- PROVISIONAL: the link the ur_to_robotiq adapter produces, which becomes
       the gripper's parent. This is the single value in this file taken from
       the adapter's conventional naming rather than read out of the file.
       03_validate_merge.sh lists every link in the expanded URDF, so if this is
       wrong you get the real name immediately rather than a confusing failure. -->
  <xacro:property name="coupler_output_link" value="${tf_prefix}gripper_mount_link"/>

  <!-- ===================================================================== -->
  <!-- Includes                                                              -->
  <!-- ===================================================================== -->
  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>
  <!-- LOCAL OVERRIDE, not the vendored package copy: knuckle joint
       velocity limit dropped 0.5 to 0.1, see that file's own header for why. -->
  <xacro:include filename="$(find ur5e_robotiq_description)/urdf/vendor/robotiq_2f_85_macro.urdf.xacro"/>
  <xacro:include filename="$(find robotiq_description)/urdf/ur_to_robotiq_adapter.urdf.xacro"/>
  <!-- Opt-in alternative gripper, validated baseline. See the gripper_model arg above. -->
  <xacro:include filename="$(find ur5e_robotiq_description)/urdf/parallel_jaw_gripper.urdf.xacro"/>

  <!-- ===================================================================== -->
  <!-- World anchor                                                          -->
  <!-- ===================================================================== -->
  <link name="world"/>

  <!-- ===================================================================== -->
  <!-- Arm                                                                   -->
  <!-- ===================================================================== -->
  <!-- Frame chain confirmed by recon, all fixed joints with zero translation:
         wrist_3_link, then rpy (0, -pi/2, -pi/2) to flange,
         then rpy (pi/2, 0, pi/2) to tool0.
       tool0 is therefore the correct mounting frame, and grasp.tcp_offset in
       scene.yaml is measured from tool0 forward to the finger-pad midpoint.
       (Do not draw those transitions as arrows: a literal double-hyphen is
       illegal anywhere inside an XML comment body and breaks the xacro parse
       with "not well-formed (invalid token)".) -->
  <xacro:ur_robot
    name="$(arg ur_type)"
    tf_prefix="${tf_prefix}"
    parent="world"
    joint_limits_parameters_file="$(arg joint_limits_parameters_file)"
    kinematics_parameters_file="$(arg kinematics_parameters_file)"
    physical_parameters_file="$(arg physical_parameters_file)"
    visual_parameters_file="$(arg visual_parameters_file)"
    safety_limits="false"
    safety_pos_margin="0.15"
    safety_k_position="20">
    <origin xyz="$(arg base_xyz)" rpy="$(arg base_rpy)"/>
  </xacro:ur_robot>

  <!-- ===================================================================== -->
  <!-- Coupler plate: UR flange -> Robotiq mount                             -->
  <!-- ===================================================================== -->
  <!-- Supplied by robotiq_description rather than hand-derived. The physical
       adapter has real thickness; mounting the gripper straight onto tool0
       would place it at the flange face and put every grasp pose out by that
       offset. -->
  <xacro:ur_to_robotiq
    prefix="${tf_prefix}"
    connected_to="${tf_prefix}tool0"
    rotation="$(arg gripper_rotation)"/>

  <!-- ===================================================================== -->
  <!-- Gripper                                                               -->
  <!-- ===================================================================== -->
  <!-- include_ros2_control defaults true, so the macro emits its own
       <ros2_control> block. Do not also declare one for the gripper below.
       gripper_model:=robotiq_linkage (default) takes this branch, producing
       an expansion identical to before gripper_model existed. -->
  <xacro:if value="${gripper_model == 'robotiq_linkage'}">
    <xacro:robotiq_gripper
      name="RobotiqGripperHardware"
      prefix="${tf_prefix}"
      parent="${coupler_output_link}"
      sim_ignition="$(arg sim_ignition)"
      sim_isaac="false"
      use_fake_hardware="false"
      fake_sensor_commands="false"
      include_ros2_control="true"
      enable_diagnostic_contacts="$(arg enable_diagnostic_contacts)"
      fingertip_grasp_theta="$(arg fingertip_grasp_theta)">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:robotiq_gripper>
  </xacro:if>

  <!-- gripper_model:=parallel_jaw — validated DART-compatible baseline, see
       docs/GRIPPER_REDESIGN_DESIGN.md. Wired into controllers.yaml and
       MoveIt (moveit_controllers_parallel_jaw.yaml); required baseline for
       the 5/5 Scene-A repeatability campaign and G1-G5 Stage-1 PASS. -->
  <xacro:if value="${gripper_model == 'parallel_jaw'}">
    <xacro:parallel_jaw_gripper
      name="ParallelJawGripperHardware"
      prefix="${tf_prefix}"
      parent="${coupler_output_link}"
      sim_ignition="$(arg sim_ignition)"
      sim_isaac="false"
      use_fake_hardware="false"
      fake_sensor_commands="false"
      include_ros2_control="true">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:parallel_jaw_gripper>
  </xacro:if>

  <!-- ===================================================================== -->
  <!-- Arm ros2_control                                                      -->
  <!-- ===================================================================== -->
  <ros2_control name="UR5eSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <!-- Initial positions put the arm in a raised, non-singular posture.
         Straight-up (all zeros) sits at the UR wrist singularity and makes
         early planning look unreliable for reasons that have nothing to do
         with the planner. -->
    <xacro:macro name="ur_joint" params="jname init">
      <joint name="${tf_prefix}${jname}">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <state_interface name="position">
          <param name="initial_value">${init}</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
    </xacro:macro>

    <xacro:ur_joint jname="shoulder_pan_joint"  init="$(arg initial_shoulder_pan)"/>
    <xacro:ur_joint jname="shoulder_lift_joint" init="$(arg initial_shoulder_lift)"/>
    <xacro:ur_joint jname="elbow_joint"         init="$(arg initial_elbow)"/>
    <xacro:ur_joint jname="wrist_1_joint"       init="$(arg initial_wrist_1)"/>
    <xacro:ur_joint jname="wrist_2_joint"       init="$(arg initial_wrist_2)"/>
    <xacro:ur_joint jname="wrist_3_joint"       init="$(arg initial_wrist_3)"/>
  </ros2_control>

  <!-- ===================================================================== -->
  <!-- Gazebo system plugin                                                  -->
  <!-- ===================================================================== -->
  <!-- One gz_ros2_control system plugin serves ALL <ros2_control> blocks in
       the model — the arm's above and the gripper's emitted by the macro.
       Both must appear in `ros2 control list_hardware_interfaces` after spawn.
       If only the arm's does, that is the two-plugin-class seam flagged in
       docs/M-1_reference_report.md §3. -->
  <gazebo>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers_file)</parameters>
    </plugin>
  </gazebo>

  <!-- JointCmdProbe, diagnostic-only, 2026-08-12, docs/gz_joint_cmd_probe/.
       Reads JointVelocityCmd directly from the ECM (PreUpdate, after
       gz_ros2_control writes it, and PostUpdate, after physics runs) to
       settle what three rounds of /joint_states reconstruction could not:
       whether right_finger_tip_joint's command is live-but-misindexed or
       stale-and-unrefreshed. MUST stay declared after gz_ros2_control's own
       <plugin> block above: gz-sim runs PreUpdate in SDF declaration
       order within a phase, and reversed order makes a live command look
       stale. See JointCmdProbe.cc's header for the full reasoning. Requires
       GZ_SIM_SYSTEM_PLUGIN_PATH to include docs/gz_joint_cmd_probe/build at
       launch time, or gz-sim will fail to find the plugin at spawn.

       GATED to gripper_model=='robotiq_linkage' (V1 fix, 2026-08-25): the
       six <joint> names below are robotiq_85_* linkage joints that do not
       exist under gripper_model:=parallel_jaw. Emitting this block
       unconditionally would reference nonexistent joints under that model.
       No equivalent diagnostic list is invented for parallel_jaw here;
       that model has no mimic/follower joints for this probe to have any
       reason to watch (see docs/GRIPPER_REDESIGN_DESIGN.md); add one only
       if a future defect actually needs it. -->
  <xacro:if value="${gripper_model == 'robotiq_linkage'}">
    <gazebo>
      <plugin filename="JointCmdProbe" name="gz::sim::systems::JointCmdProbe">
        <joint>robotiq_85_left_knuckle_joint</joint>
        <joint>robotiq_85_right_knuckle_joint</joint>
        <joint>robotiq_85_left_finger_tip_joint</joint>
        <joint>robotiq_85_right_finger_tip_joint</joint>
        <joint>robotiq_85_left_inner_knuckle_joint</joint>
        <joint>robotiq_85_right_inner_knuckle_joint</joint>
        <output>/tmp/joint_cmd_probe.csv</output>
      </plugin>
    </gazebo>
  </xacro:if>

  <!-- Gazebo's OWN joint state output, independent of ros2_control.
       This is not redundant with joint_state_broadcaster. It is the entire
       basis of M0-C: the mimic-tracking check compares gz-sim's constraint
       solver output against the URDF mimic spec, and it cannot use
       /joint_states because /joint_states is what ros2_control believes, which
       is precisely the thing under test. The donor repo's open readback defect
       (joint effort off by up to ~15x) is the reason that distinction matters.

       Publishes on:  /world/<world>/model/<model>/joint_state
       scripts/m0_verify.sh defaults to WORLD=empty MODEL=ur5e_robotiq.
       Keep the launch file's world name and spawned model name consistent with
       those, or pass WORLD=/MODEL= to override.

       VERIFY, do not assume: the plugin filename below is the Harmonic
       (gz-sim 8) name. Confirm it loaded by checking that the topic appears in
       `gz topic -l` after spawn. If it does not, M0-C has no ground truth and
       cannot pass — that is a blocker, not a nice-to-have. -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
    </plugin>
  </gazebo>

  <!-- ===================================================================== -->
  <!-- CAMERA — fixed overhead RGB-D (eye-to-hand)                           -->
  <!-- ===================================================================== -->
  <!-- MOUNT DERIVATION (from config/scene.yaml, not chosen by eye):
         table.surface_z            = 0.750
         object.pick_pose           = (0.450, -0.150, 0.7725)
         object.place_pose          = (0.450, +0.200, 0.7725)
         x is common to both poses  -> camera x = 0.450
         y midpoint (-0.150+0.200)/2 = 0.025  -> camera y = 0.025
         camera z = 2.400  => 1.650 m above the table surface.

       HEIGHT HISTORY, so the number is auditable:
         z = 1.600 was tried first (0.850 m above the table) and MEASURED to
         fail the static visibility check: with the arm at its home pose the
         UR5e upper arm reaches z = 1.394, only 0.206 m below the camera, and
         occluded 46.1% of the required workspace rectangle (43.9% of the
         whole frame). The original derivation accounted for the commanded
         tool0 heights (max 1.044478) but not for the elbow/upper-arm
         envelope, which sits far higher at home. z = 2.400 puts the same arm
         1.006 m away against a 1.650 m table distance, so the arm subtends a
         proportionally much smaller solid angle.

       COVERAGE at 1.650 m with hfov=1.047 rad (60 deg) and 640x480:
         horizontal footprint = 2*1.650*tan(30.000 deg) = 1.9053 m
         vertical   footprint = 2*1.650*tan(23.409 deg) = 1.4283 m
       Image x maps to world -Y, image y maps to world -X (see the optical
       frame note below), so the visible ground rectangle is
         world Y in [-0.928, +0.978]   table spans [-0.40, +0.40]
         world X in [-0.264, +1.164]   table spans [-0.05, +1.15]
       At this height the ENTIRE table is inside the frame in both axes,
       which the 1.600 m mount could not do in x.

       COST: raising the camera reduces object pixel density. Quantifying that
       trade-off requires an object-present capture at this final height; the
       live structural validation only confirms the streams, calibration and
       frame geometry, so no unmeasured footprint is claimed here. -->
  <xacro:if value="$(arg enable_camera)">

    <!-- camera_link follows the ROS body convention (REP-103): +X forward
         along the view direction, +Y left, +Z up. rpy="0 pi/2 0" pitches +X
         from world +X down to world -Z, i.e. the camera looks straight down.
         Resulting axis mapping, needed by any later pixel-to-world work:
           camera_link +X = world -Z   (view direction, down)
           camera_link +Y = world +Y
           camera_link +Z = world +X -->
    <link name="${tf_prefix}camera_link">
      <!-- COLLISIONLESS on purpose: this sensor must never enter the contact,
           friction or grasp solution. It does carry a token inertial, and
           that is load-bearing rather than cosmetic: the URDF to SDF
           converter LUMPS a massless fixed-joint child into its parent (the
           same mechanism that produces the
           robotiq_85_left_knuckle_link_fixed_joint_lump__... names on the
           fingertips). When camera_link was lumped into world, camera_link
           stopped existing as an SDF link and Gazebo rejected the model with
           "attached_to name[camera_link] ... does not match a nested model,
           link, joint, or frame name". The mass below is 1e-6 kg attached by
           a fixed joint to the static world link, so it contributes nothing
           to any dynamics; it exists purely to keep the link addressable. -->
      <inertial>
        <mass value="1.0e-6"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="1.0e-9" ixy="0.0" ixz="0.0"
                 iyy="1.0e-9" iyz="0.0" izz="1.0e-9"/>
      </inertial>
      <visual>
        <geometry>
          <box size="0.030 0.090 0.025"/>
        </geometry>
        <material name="camera_dark">
          <color rgba="0.15 0.15 0.15 1.0"/>
        </material>
      </visual>
    </link>

    <joint name="${tf_prefix}world_to_camera_joint" type="fixed">
      <parent link="world"/>
      <child link="${tf_prefix}camera_link"/>
      <origin xyz="0.450 0.025 2.400" rpy="0 ${pi/2} 0"/>
    </joint>

    <!-- Explicit belt-and-braces against the lumping described above. The
         inertial alone is what actually fixes it on this sdformat version;
         this tag states the intent so a future converter change cannot
         silently reintroduce the failure. -->
    <gazebo reference="${tf_prefix}world_to_camera_joint">
      <preserveFixedJoint>true</preserveFixedJoint>
      <disableFixedJointLumping>true</disableFixedJointLumping>
    </gazebo>

    <!-- Optical frame, REP-103 / REP-145: +Z along the view direction,
         +X right in the image, +Y down in the image. The rpy below is the
         standard body-to-optical rotation and yields, against the camera_link
         orientation above:
           optical +Z = camera_link +X = world -Z  (into the scene, down)
           optical +X = camera_link -Y = world -Y  (image right)
           optical +Y = camera_link -Z = world -X  (image down)
         So in the rendered image world +X points UP and world +Y points LEFT.
         The robot base (x=0) is therefore at the BOTTOM of the frame and the
         place pose (y=+0.200) is LEFT of the pick pose (y=-0.150). -->
    <link name="${tf_prefix}camera_optical_frame"/>

    <joint name="${tf_prefix}camera_optical_joint" type="fixed">
      <parent link="${tf_prefix}camera_link"/>
      <child link="${tf_prefix}camera_optical_frame"/>
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <!-- The sensor is attached to camera_link, but <gz_frame_id> pins the
         frame_id stamped into Image and CameraInfo to the OPTICAL frame,
         which is what every downstream ROS consumer expects. Without it the
         messages would carry camera_link and every projection would be
         silently rotated. -->
    <gazebo reference="${tf_prefix}camera_link">
      <sensor name="overhead_rgbd" type="rgbd_camera">
        <topic>overhead_camera</topic>
        <gz_frame_id>${tf_prefix}camera_optical_frame</gz_frame_id>
        <update_rate>5</update_rate>
        <always_on>1</always_on>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>$(arg camera_width)</width>
            <height>$(arg camera_height)</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <!-- near 0.10 is well inside the 0.850 m table distance; far 3.0
                 reaches the floor (1.600 m away) with room to spare. -->
            <near>0.10</near>
            <far>3.0</far>
          </clip>
        </camera>
      </sensor>
    </gazebo>

  </xacro:if>

  <!-- Grounding needs NOTHING here. It comes from <link name="world"/> plus
       ur_robot(parent="world"), which creates a fixed joint to it.
       An earlier revision put <static>true</static> in this block. That was
       wrong twice over: <static> is a MODEL-level SDF property, not per-link,
       and the grounding it claimed to provide was already handled. Had the SDF
       converter honoured it at model scope it would have frozen every joint in
       the robot — spawning fine, reporting healthy, never moving, with no error
       to search for. Verified against ur_simulation_gz's own ur_gz.urdf.xacro,
       which spawned successfully in the arm-only sanity run: its equivalent
       block is empty. Keep it empty. -->
  <gazebo reference="world">
